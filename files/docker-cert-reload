#!/usr/bin/env bash
set -euo pipefail

CERT_DIR="${1:?Certificate directory required}"
GID="${2:?Application GID required}"
CONTAINER="${3:?Docker container name required}"

# Set private key permissions
chown "root:${GID}" "${CERT_DIR}/key.pem"
chmod 0640 "${CERT_DIR}/key.pem"

# Restart the application only if the container is running
if [[ "$(/usr/bin/docker inspect \
    --format '{{.State.Running}}' \
    "${CONTAINER}" 2>/dev/null || true)" == "true" ]]; then

    echo "Restarting Docker container: ${CONTAINER}"
    /usr/bin/docker restart -t 60 "${CONTAINER}"
else
    echo "Docker container ${CONTAINER} does not exist or is not running; skipping restart."
fi
