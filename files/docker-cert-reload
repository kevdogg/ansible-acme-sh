#!/usr/bin/env bash
set -euo pipefail

CERT_DIR="${1:?Certificate directory required}"
GID="${2:?Application GID required}"
CONTAINER="${3:?Docker container name required}"

# Set private key permissions
chown "root:${GID}" "${CERT_DIR}/key.pem"
chmod 0640 "${CERT_DIR}/key.pem"

# Restart the application
/usr/bin/docker restart -t 60 "${CONTAINER}"
